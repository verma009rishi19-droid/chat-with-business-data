# Environment Configuration Template
# Copy this file to .env and provide your actual credentials. DO NOT commit .env.

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Connection (PostgreSQL)
# Admin URL used for migrations/seed loading
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_db
# Read-only URL used strictly by the agent execution runtime
DATABASE_READONLY_URL=postgresql://readonly_analyst:readonly_pass@localhost:5432/business_db
# Set DB_TYPE to 'sqlite' for quick local fallback without Docker
DB_TYPE=postgres
SQLITE_DB_PATH=data/warehouse.db

# Vector Store (Chroma)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=business_knowledge_base

# Observability (Optional)
OBSERVABILITY_PROVIDER=none # 'langfuse', 'langsmith', or 'none'
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Service Ports
API_PORT=8000
UI_PORT=8501
